# Copy to .env.local for local work. Never commit real values.

# --- Public (safe in the browser) ---
# Canonical site address used for SEO, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.lovelynailsbarrie.com
# Sanity project and dataset (defaults are built in; override only for a test dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID=5nfqbapg
NEXT_PUBLIC_SANITY_DATASET=production

# --- Server only ---
# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Editor token used only by `npm run seed` on your machine. Do not add it to Vercel.
SANITY_API_WRITE_TOKEN=

# Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Secret key in the one-time connect link: /studio-tools/instagram?key=...
INSTAGRAM_CONNECT_KEY=
# Edge Config connection string (added automatically when you connect the store to the project).
EDGE_CONFIG=
# Vercel access token allowed to write that Edge Config store.
VERCEL_API_TOKEN=
# Only if the Edge Config store belongs to a Vercel team: the team ID (team_...).
VERCEL_TEAM_ID=
# Vercel sends this as a Bearer token to the daily cron job.
CRON_SECRET=
